---
import { Image } from 'astro:assets';
import { site } from '../data/site';
const mailto = `mailto:${site.email}`;
const { footer } = site;
---

<footer data-screen-label="Footer">
  <div class="foot-letter band wrap">
    <div class="foot-letter__row inner">
      <div class="foot-letter__lead">
        <p class="display">{footer.lead}</p>
      </div>
      <a class="foot-link" href={mailto} data-booker-open>{site.email}</a>
    </div>
    <div class="inner"><hr class="hair" /></div>
    <p class="foot-letter__copy inner">{footer.copy} <span class="foot-sep">·</span> <a class="foot-link foot-link--inline" href="/privacy">Privacy</a></p>
  </div>
  <div class="os-bar">
    <span class="os-bar__mark"><Image class="os-bar__mark-img" src={site.logo} alt={site.logoAlt} width={128} densities={[1, 2]} loading="lazy" /></span>
    {footer.barCells.map((cell) => <span class="os-bar__cell">{cell}</span>)}
  </div>
</footer>
