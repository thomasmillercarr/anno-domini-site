---
import { Image } from 'astro:assets';
import { site } from '../data/site';
const { manifesto } = site;
---

<section class="manifesto band wrap" id="about" data-screen-label="Manifesto">
  <Image
    class="manifesto__slot"
    src={manifesto.image}
    alt={manifesto.imageAlt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="manifesto__veil"></div>
  <div class="manifesto__inner inner">
    <div class="mpanel frost">
      <h2 class="display mpanel__h">{manifesto.heading}</h2>
      <div class="principles">
        {manifesto.principles.map((p) => (
          <div class="principle">
            <Fragment set:html={p.icon} />
            <p>{p.text}</p>
          </div>
        ))}
      </div>
      <p class="mpanel__foot">{manifesto.foot}</p>
    </div>
  </div>
</section>
