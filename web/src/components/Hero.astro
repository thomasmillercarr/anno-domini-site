---
import { site } from '../data/site';
const { hero } = site;

// The headline ships pre-split into masked word spans. reveal.ts used to do
// this at runtime, which meant the h1 stayed at opacity 0 until GSAP had
// parsed — real text in the HTML instead, animated by CSS alone.
const leadWords = hero.headlineLead.split(/(\s+)/).filter((p) => p.trim());
---

<header class="hero" data-screen-label="Hero">
  {/* The backdrop is generated, not photographed — scripts/herofield.ts paints a
      WebGL filament field here at the display's own resolution. Purely
      decorative, and .hero carries a CSS gradient underneath that stands alone
      if WebGL is unavailable, so it is hidden from assistive tech. */}
  <canvas class="hero__slot" aria-hidden="true"></canvas>
  <div class="hero__veil"></div>
  <div class="hero__grid wrap inner">
    <div>
      <p class="label hero__sub">{hero.sub}</p>
      <h1 class="display-xl hero__h1">{leadWords.map((word, i) => (
        <><span class="w"><span class="w__i" style={`--wi:${i}`}>{word}</span></span>{' '}</>
      ))}<span class="w"><em class="w__i" style={`--wi:${leadWords.length}`}>{hero.headlineEm}</em></span></h1>
      <div class="hero__cta">
        <a class="btn btn--onimg" href={hero.ctaHref}><span class="mk" aria-hidden="true">&rarr;</span> {hero.cta}</a>
      </div>
    </div>
    <div class="statcard frost">
      <p class="statcard__cap">{hero.stat.cap}</p>
      <p class="statcard__val"><span class="statcard__num" data-countup={hero.stat.value}>{hero.stat.value}</span><span class="statcard__unit">{hero.stat.unit}</span></p>
      <p class="statcard__note">{hero.stat.note}</p>
      <div class="statcard__chart">
        <svg viewBox="0 0 300 46" preserveAspectRatio="none" fill="none">
          {/* currentColor, not a literal — .statcard sets color: var(--on-img),
              which the hero scopes to dark ink over the light field and back to
              near-white over the dark one. A hardcoded #F6F2EA would survive
              both the theme flip and the contrast probe's colour override. */}
          <polyline class="statcard__line" points="0,40 38,34 76,36 114,26 152,28 190,18 228,20 266,9 300,6"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
          <circle class="statcard__dot" cx="300" cy="6" r="2.6" fill="currentColor"></circle>
        </svg>
      </div>
    </div>
  </div>
</header>
