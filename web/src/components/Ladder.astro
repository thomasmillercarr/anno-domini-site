---
import { site } from '../data/site';
const { ladder } = site;
---

<section class="ladder band wrap" data-screen-label="The ladder">
  <p class="label inner ladder__label">{ladder.label}</p>
  <div class="inner">
    {ladder.rungs.map((rung) => (
      <div class:list={['rung', { 'rung--active': rung.active }]}>
        <div class="rung__label">{rung.label}</div>
        <p class="rung__desc">{rung.desc}</p>
        <span class:list={['rung__tag', { empty: !rung.active }]}>{rung.tag}</span>
      </div>
    ))}
  </div>
</section>
