---
import { site } from '../data/site';
import Schema from '../components/Schema.astro';
import '../styles/os-site.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.brandFull, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// A dedicated 1200x630 JPEG, hand-made rather than derived from anything on the
// page — several scrapers (LinkedIn, Slack) don't render WebP at all.
const ogImage = new URL('/assets/og.jpg', Astro.site).href;
---

<!DOCTYPE html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.brandFull} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Matches the two theme grounds so mobile browser chrome doesn't clash. -->
    <meta name="theme-color" content="#F4F1EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161412" media="(prefers-color-scheme: dark)" />

    <!-- Structured data (Organization / WebSite / WebPage) -->
    <Schema />

    <!-- Fonts: self-hosted Archivo (see @font-face in os-site.css). Preload the
         critical latin upright so first paint has the variable font ready. -->
    <link rel="preload" href="/fonts/archivo-latin-normal-subset.woff2" as="font" type="font/woff2" crossorigin />

    <!-- No hero preload: the hero backdrop is generated (scripts/herofield.ts),
         so there is no image to discover. LCP is the headline, which paints
         from HTML + CSS with nothing to fetch first. -->

    <!-- No-FOUC theme init + motion gate: must run before paint, so it stays
         inline & un-bundled. The `motion` class arms the CSS motion layer
         (entrance holds, parallax bleed) only when JS is running and the
         visitor allows motion — see the MOTION LAYER block in os-site.css. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('os-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <!-- theme.ts is tiny and wires the mode toggle, so it stays in the entry
         chunk. Everything else pulls in GSAP + Lenis (~170KB); loading that
         eagerly costs main-thread time before the page is even interactive, so
         it waits for idle. Nothing below depends on running before first paint. -->
    <script>
      import '../scripts/theme';

      const idle: (cb: () => void) => void =
        window.requestIdleCallback?.bind(window) ?? ((cb) => setTimeout(cb, 1));

      idle(() => {
        // The hero backdrop first: it is the one thing here the visitor can
        // actually see waiting for. It fades in over the CSS gradient, so
        // arriving late costs nothing but a softer entrance. heroocean picks
        // between the WebGPU ocean and the WebGL2 field and imports only one.
        import('../scripts/heroocean');
        import('../scripts/scroll');
        import('../scripts/statcard');
        import('../scripts/pointer');
        import('../scripts/reveal');
        import('../scripts/booker');
      });
    </script>
  </body>
</html>
